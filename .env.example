# ===================================================================
# Hebekery Healthy Bakery - Environment Variables Configuration Template
# Sao chep file nay thanh .env de cau hinh bien moi truong thuc te.
# Tuyet doi khong commit file .env chua thong tin that len Git.
# ===================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/hebekery?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=root_password

# JWT Authentication (Spring Security)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# SePay & VietQR Automated Payment (Nap vao khi tich hop cong SePay)
SEPAY_WEBHOOK_API_KEY=sepay_secret_key_12345
SEPAY_ACCOUNT_NUMBER=0987654321
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_HOLDER=TIEM BANH HEBEKERY

# Cloudinary Media Storage & CDN (Nap tu tai khoan Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
